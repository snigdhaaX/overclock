# Copy to .env and fill in real values. NEVER commit .env.
# Use a dedicated TEST wallet that only holds Amoy test POL.

# Hosted RPC endpoint (Alchemy / Infura / QuickNode / public Amoy RPC)
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<YOUR_API_KEY>
POLYGON_AMOY_CHAIN_ID=80002

# 64-hex private key of the dedicated test deployer wallet (no seed phrases!)
DEPLOYER_PRIVATE_KEY=<YOUR_TEST_WALLET_PRIVATE_KEY>

# Optional: role holders (default to deployer)
TRUSTCHAIN_ADMIN_ADDRESS=
TRUSTCHAIN_REGISTRAR_ADDRESS=

# Filled in after deployment
TRUSTCHAIN_CONTRACT_ADDRESS=

# Optional: Polygonscan / Etherscan V2 API key for source verification
POLYGONSCAN_API_KEY=

# Optional
DEPLOY_CONFIRMATIONS=2
REPORT_GAS=false
