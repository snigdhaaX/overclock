# ===================================================================
# TRUSTCHAIN PLATFORM ENVIRONMENT CONFIGURATION
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ===================================================================

# -------------------------------------------------------------------
# Blockchain & RPC (Polygon Amoy Testnet)
# -------------------------------------------------------------------
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_AMOY_CHAIN_ID=80002

# Deployed Smart Contract Address (populated after Milestone 5 deployment)
TRUSTCHAIN_CONTRACT_ADDRESS=

# Confirmation threshold before marking transaction confirmed
CONFIRMATION_BLOCKS=2

# -------------------------------------------------------------------
# Backend & Database Configuration
# -------------------------------------------------------------------
# Default is zero-installation SQLite. Point to PostgreSQL when ready:
# postgresql+psycopg://username:password@localhost:5432/trustchain
DATABASE_URL=sqlite:///./trustchain.db

# Wallet linking nonce expiry in seconds (default 5 minutes)
NONCE_EXPIRY_SECONDS=300
APP_DOMAIN=trustchain.supplychain.io

# -------------------------------------------------------------------
# Deployer Wallet (Dedicated Testnet Wallet Only - NO SEED PHRASES)
# Used only by Hardhat deployment scripts; NEVER by FastAPI or backend
# -------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=<64_HEX_CHARACTERS_WITHOUT_0x>
POLYGONSCAN_API_KEY=<OPTIONAL_API_KEY>

# -------------------------------------------------------------------
# Mobile app
# -------------------------------------------------------------------
# Optional. Defaults to the machine serving the Expo bundle, on port 8000.
EXPO_PUBLIC_API_URL=
# Which organization's risk model to use. A placeholder until real login exists.
EXPO_PUBLIC_RISK_ORG_ID=org:synthetic-demo
